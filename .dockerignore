# Large directories not needed for builds
node_modules/
.git/
dist/
.codex/
openspec/
guidelines/
__figma__entrypoint__.ts

# Plain JARs (avoid wildcard collisions)
**/*-plain.jar

# Build caches and outputs (keep libs/ for JAR copy)
**/build/classes/
**/build/generated/
**/build/reports/
**/build/resources/
**/build/tmp/
**/bin/
**/.gradle/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Infra scripts (not needed in image builds)
equipmap-infra/
