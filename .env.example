# EquipMap - variaveis de ambiente do frontend
# Copie para .env.local se quiser ajustar os valores no dev server local.

# Endpoint GraphQL do BFF. Obrigatorio para executar o frontend.
VITE_API_BASE_URL=http://localhost:4000/graphql

# Timeout das requisicoes em milissegundos.
VITE_API_TIMEOUT=10000

# Prefixo do token no Authorization header.
VITE_AUTH_TOKEN_TYPE=Bearer

# Chave do localStorage onde o token JWT e armazenado.
VITE_AUTH_TOKEN_KEY=equipmap_auth_token

# Ambiente da aplicacao: development | staging | production.
VITE_APP_ENV=development
