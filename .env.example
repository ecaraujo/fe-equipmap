# ─────────────────────────────────────────────────────────────────────────────
# EquipMap – Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ─────────────────────────────────────────────────────────────────────────────

# URL base da API REST (ex: https://api.meucondominioapp.com/v1)
# Deixe em branco para usar dados mock (modo demonstração)
VITE_API_BASE_URL=

# Timeout das requisições em milissegundos (padrão: 10000)
VITE_API_TIMEOUT=10000

# Prefixo do token no Authorization header (padrão: Bearer)
VITE_AUTH_TOKEN_TYPE=Bearer

# Chave do localStorage onde o token JWT é armazenado
VITE_AUTH_TOKEN_KEY=equipmap_auth_token

# Ambiente da aplicação (development | staging | production)
VITE_APP_ENV=development
