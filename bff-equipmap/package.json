{
  "name": "bff-equipmap",
  "version": "0.1.0",
  "private": true,
  "description": "EquipMap GraphQL BFF for routing frontend operations to EquipMap microservices.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json && npm run export:schema",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "tsx src/contract-test.ts",
    "test:contract": "tsx src/contract-test.ts",
    "export:schema": "node scripts/export-schema.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "engines": {
    "node": ">=20"
  }
}
